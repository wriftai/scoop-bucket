        "if (!(Test-Path $PROFILE)) { New-Item -ItemType File -Path $PROFILE -Force | Out-Null }",
        "if (-not (Select-String -Path $PROFILE -Pattern [regex]::Escape($script) -Quiet)) { Add-Content -Path $PROFILE -Value \"`n# wriftai completion`nImport-Module `\"$script`\"\" }",
